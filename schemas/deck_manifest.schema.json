{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Native Composer Deck Manifest",
  "type": "object",
  "required": ["manifest_version", "deck_id", "deck_title", "source_provenance", "page_numbering", "pages", "output", "runtime_options"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "deck_title": {"type": "string", "minLength": 1},
    "source_provenance": {"type": "object"},
    "theme_strategy": {"type": "object"},
    "page_numbering": {"type": "object", "required": ["policy"], "properties": {"policy": {"enum": ["manifest_order", "preserve_page_runtime"]}}, "additionalProperties": true},
    "failure_policy": {"enum": ["strict", "isolate_and_continue"]},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "order", "section", "page_role", "page_runtime_manifest", "dependencies", "required", "continuity_group"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "section": {"type": "string"},
          "page_role": {"enum": ["cover", "section_opener", "strategy", "concept", "evidence", "execution", "summary", "closing", "custom"]},
          "page_runtime_manifest": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"},
          "continuity_group": {"type": "string"},
          "route": {"enum": ["element_asset_hybrid", "full_substrate_hybrid", "visual_reference_mode", "template_native_plus_skin", "pure_native_safety"]}
        },
        "additionalProperties": true
      }
    },
    "output": {"type": "object", "required": ["root"], "properties": {"root": {"type": "string"}}, "additionalProperties": true},
    "runtime_options": {"type": "object", "properties": {"resume": {"type": "boolean"}, "jobs": {"type": "integer", "minimum": 1}, "preview_dpi": {"type": "integer", "minimum": 36}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
