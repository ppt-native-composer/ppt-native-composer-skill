{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ppt-native-composer/deck_blueprint.schema.json",
  "title": "PPT Native Composer Deck Blueprint",
  "type": "object",
  "required": [
    "final_script_source",
    "deck_brief",
    "visual_bible",
    "page_family_map",
    "asset_generation_policy",
    "editability_policy",
    "validation_policy",
    "font_plan",
    "slides"
  ],
  "properties": {
    "final_script_source": {
      "type": "object",
      "required": ["path", "filename", "digest", "confirmed"],
      "properties": {
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "digest": { "type": "string" },
        "confirmed": { "type": "boolean", "default": false },
        "project_name": { "type": "string" },
        "selected_slide_range": {
          "type": "array",
          "items": { "type": ["integer", "string"] }
        }
      },
      "additionalProperties": true
    },
    "deck_brief": {
      "type": "object",
      "required": ["project_name", "deck_type", "audience", "objective"],
      "properties": {
        "project_name": { "type": "string" },
        "deck_type": { "type": "string" },
        "audience": { "type": "string" },
        "objective": { "type": "string" },
        "creative_summary": { "type": "string" },
        "production_notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "visual_bible": { "$ref": "./visual_bible.schema.json" },
    "page_family_map": { "type": "object" },
    "page_production_route": {
      "type": "object",
      "description": "Draft/approved route plan. Required by validate_blueprint.py for assembly/deliverable, either here or per slide/ref."
    },
    "page_production_route_ref": {
      "type": "string",
      "description": "Path to route plan JSON relative to project folder or absolute."
    },
    "composition_archetype": {
      "type": "object",
      "description": "Approved composition archetype or archetype collection. Required by validate_blueprint.py for assembly/deliverable, either here or per slide/ref."
    },
    "composition_archetype_ref": {
      "type": "string",
      "description": "Path to composition archetype JSON relative to project folder or absolute."
    },
    "asset_generation_policy": {
      "type": "object",
      "required": [
        "image_generation_authorized",
        "ask_before_batch_generation",
        "ask_before_exact_chinese_text_in_image",
        "ask_before_real_logo_or_medical_claim"
      ],
      "properties": {
        "image_generation_authorized": { "type": "boolean", "const": true },
        "ask_before_batch_generation": { "type": "boolean" },
        "ask_before_exact_chinese_text_in_image": { "type": "boolean" },
        "ask_before_real_logo_or_medical_claim": { "type": "boolean" },
        "allow_placeholder_for_draft_only": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "editability_policy": {
      "type": "object",
      "required": [
        "title_must_be_editable",
        "page_number_must_be_editable",
        "body_default_editable",
        "tables_default_editable",
        "execution_info_default_editable"
      ],
      "properties": {
        "title_must_be_editable": { "type": "boolean", "const": true },
        "page_number_must_be_editable": { "type": "boolean", "const": true },
        "body_default_editable": { "type": "boolean" },
        "tables_default_editable": { "type": "boolean" },
        "execution_info_default_editable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validation_policy": {
      "type": "object",
      "required": [
        "no_svg_shadow",
        "no_container_shadow",
        "no_card_shadow",
        "no_fake_depth",
        "visual_qa_required"
      ],
      "properties": {
        "no_svg_shadow": { "type": "boolean", "const": true },
        "no_container_shadow": { "type": "boolean", "const": true },
        "no_card_shadow": { "type": "boolean", "const": true },
        "no_fake_depth": { "type": "boolean", "const": true },
        "visual_qa_required": { "type": "boolean", "const": true },
        "asset_delete_test_required": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "font_plan": {
      "type": "object",
      "required": ["cjk", "latin", "fallback", "hierarchy", "display_text_policy"],
      "properties": {
        "cjk": { "type": "string" },
        "latin": { "type": "string" },
        "fallback": { "type": "array", "items": { "type": "string" } },
        "hierarchy": { "type": "object" },
        "type_scale": {
          "type": "object",
          "properties": {
            "display": { "$ref": "#/$defs/type_scale_item" },
            "title": { "$ref": "#/$defs/type_scale_item" },
            "claim": { "$ref": "#/$defs/type_scale_item" },
            "section": { "$ref": "#/$defs/type_scale_item" },
            "body": { "$ref": "#/$defs/type_scale_item" },
            "label": { "$ref": "#/$defs/type_scale_item" },
            "caption": { "$ref": "#/$defs/type_scale_item" },
            "page_number": { "$ref": "#/$defs/type_scale_item" }
          },
          "additionalProperties": { "$ref": "#/$defs/type_scale_item" }
        },
        "display_text_policy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./slide_blueprint.schema.json" }
    },

    "style_pack": {
      "$ref": "./style_pack.schema.json",
      "description": "Legacy/reference-only field. Do not use as the production route."
    }
  },
  "$defs": {
    "type_scale_item": {
      "type": "object",
      "required": ["cjk_size_pt", "latin_size_pt", "weight", "line_height", "min_contrast"],
      "properties": {
        "cjk_size_pt": { "type": "number" },
        "latin_size_pt": { "type": "number" },
        "weight": { "type": "string" },
        "line_height": { "type": "number" },
        "min_contrast": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
